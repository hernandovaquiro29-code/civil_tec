<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DETALLES DEL PROYECTO"
            android:textColor="@color/amarillo"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"/>
        <ImageView
            android:id="@+id/tvImagenPr"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:text="IMAGEN ALUSIVA DEL PROYECTO"
            android:textColor="@color/negro"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@color/blanco"
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/gris_claro"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDetPronombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del proyecto"
                android:textColor="@color/azul"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="INFORMACIÓN GENERAL"
                android:textColor="@color/azul"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvDetDes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Descripción del proyecto"
                android:textColor="@color/negro"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/tvDetPresu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Presupuesto"
                android:textColor="@color/azul"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvDetUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ubicación: No registrada"
                android:textColor="@color/negro"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/tvDetTipoEdificacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tipo de edificación: No registrado"
                android:textColor="@color/negro"
                android:textSize="16sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/texto_de_input"
            android:layout_marginTop="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PLANOS"
                android:textColor="@color/azul"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvEstadoPl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comprobando planos"
                android:textColor="@color/texto_de_input"
                android:textSize="16sp"
                android:layout_marginTop="16dp"/>
            <Button
                android:id="@+id/btnAbrirPl"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="ABRIR / DESCARGAR PLANO"
                android:textColor="@color/blanco"
                android:backgroundTint="@color/azul"
                android:layout_marginTop="16dp"
                android:enabled="false"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PARTES DEL PROYECTO"
            android:textColor="@color/azul"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"/>
        <Button
            android:id="@+id/btncalcuabrir"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="CÁLCULOS ESTRUCTURALES    ›"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:backgroundTint="@color/azul"/>
        <Button
            android:id="@+id/btnCalcuResu"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="RESULTADOS Y REGISTROS    ›"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:backgroundTint="@color/azul"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
