<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CIVIL-TEC"
            android:textColor="@color/azul"
            android:textSize="24sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu mejor herramienta"
            android:textColor="@color/texto_de_input"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis proyectos"
            android:textColor="@color/amarillo"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Administra tus proyectos y planos."
            android:textColor="@color/texto_de_input"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>
        <Button
            android:id="@+id/btnAñadirPr"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="+ NUEVO PROYECTO"
            android:textStyle="bold"
            android:textColor="@color/azul"
            android:backgroundTint="@color/amarillo"
            android:layout_marginTop="24dp"/>
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CERRAR SESIÓN"
            android:layout_margin="16dp"/>

        <TextView
            android:id="@+id/tvvacioPr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todavía no tienes proyectos registrados."
            android:textColor="@color/texto_de_input"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="32dp"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:id="@+id/contenPr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>
